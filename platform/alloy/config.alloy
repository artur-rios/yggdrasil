// Every container Compose started on this Docker engine -> Loki: the platform's (scripts/platform.sh) and
// the applications' (scripts/deploy.sh). Not a one-off `docker run`: see discovery.relabel "compose".
//
// Labels are kept few on purpose (Loki indexes labels, not content): the environment, the Compose
// project (stack) and service, the container, and the log level. Everything else stays in the JSON
// line and is queried with `| json`.
//
// One host can run several environments, so the environment is each container's own: the
// yggdrasil.environment label scripts/deploy.sh puts on every application container. The platform's
// containers serve every environment of the host and have none, so their lines have no environment
// label ({environment=""} selects them in LogQL).

// Docker through alloy-docker-proxy (platform/compose.yml), which allows only the read-only requests
// these two components make, never the socket itself.
discovery.docker "containers" {
  host = "tcp://alloy-docker-proxy:2375"
}

// Only containers with a Compose project. A container `docker run` starts has none, and its output can be
// anything: scripts/backup.sh and scripts/volumes.sh tar a volume to the container's stdout, which the engine
// logs like any other output. Shipped, the nightly backup of the Jenkins volume was 2.5 to 6 GB of gzip a
// night in the DevOps Server's Loki (30 GB of its 31 days), under a made-up name such as elastic_gagarin.
// Dropped here, before loki.source.docker: its relabel_rules only rename labels, they never stop a tail.
discovery.relabel "compose" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = ".+"
    action        = "keep"
  }
}

discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "stack"
  }

  // An empty value (no such container label) sets no label.
  rule {
    source_labels = ["__meta_docker_container_label_yggdrasil_environment"]
    target_label  = "environment"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "tcp://alloy-docker-proxy:2375"
  targets       = discovery.relabel.compose.output
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.containers.receiver]
}

loki.process "containers" {
  // Serilog's JsonFormatter writes "Level" (Information, Warning, ...); Traefik, Grafana and Loki
  // write "level". Lines that are not JSON pass through without a level.
  stage.json {
    expressions = { level = "Level || level" }
  }

  stage.labels {
    values = { level = "" }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
