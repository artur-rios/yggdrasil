# The daily prune of ygg's engine, a user unit of `ygg` on both machines: it is installed into
# ~ygg/.config/systemd/user/ by `ygg install` (step prune-timer) and started by the timer next to it. ygg's
# engine builds every deploy's images on an Application Server, and the Jenkins images on the DevOps Server,
# and BuildKit keeps the cache of every build: 139 GB of it on an Application Server before this unit.
#
# Only leftovers, never what runs: this engine holds the platform and every deployed environment, and an
# on-demand environment that is switched off is a set of stopped containers. So no `system prune`, and no
# container, volume or network prune.
[Unit]
Description=Prune the dangling images and the build cache of ygg's engine, never its containers, volumes or tagged images
# The prune runs against ygg's own rootless engine, which is the user unit docker.service: a catch-up run at
# boot (the timer is Persistent) must wait for it.
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
# A user unit doesn't read ygg's .profile, which is where its shells get DOCKER_HOST: %t is ygg's runtime
# directory, where its rootless engine keeps the socket. Never the system's engine.
Environment=DOCKER_HOST=unix://%t/docker.sock
# Dangling images only (no --all): untagged leftovers of a rebuilt tag, which nothing can run by name. Not
# every unused image: scripts/deploy.sh keeps the last keepImages images of each application in each
# environment (catalog.yaml) for its rollbacks, and none of them but the running one has a container.
ExecStart=/usr/bin/docker image prune --force
# The build cache no build has used for a week, then by size (the same two runs as the CI engines'
# yggdrasil-prune.service, and for the same reason: BuildKit never removes a record younger than `until`):
# the records used least, and least recently, until the rest is under 20 GB.
ExecStart=/usr/bin/docker builder prune --all --force --filter until=168h
ExecStart=/usr/bin/docker builder prune --all --force --max-used-space 20GB
# A prune that hangs (an engine that never answers) must not hold the next one off for ever.
TimeoutStartSec=2h
