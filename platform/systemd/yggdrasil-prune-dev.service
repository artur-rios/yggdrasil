# The daily prune of dev's engine, a user unit of `dev` on the dev machine: it is installed into
# ~dev/.config/systemd/user/ by `ygg install` (step prune-timer) and started by the timer next to it. dev's
# engine runs the AI development sessions' containers (a test suite's databases, an image built to try a
# Dockerfile), and BuildKit keeps the cache of every build.
#
# Only leftovers, never what the owner may come back to: a database stopped between two sessions is a stopped
# container, and the images the tests pull are tagged images no container uses between two runs. So no
# `system prune`, and no container, volume or network prune.
[Unit]
Description=Prune the dangling images and the build cache of dev's engine, never its containers, volumes or tagged images
# The prune runs against dev's own rootless engine, which is the user unit docker.service: a catch-up run at
# boot (the timer is Persistent) must wait for it.
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
# A user unit doesn't read dev's .profile, which is where its shells get DOCKER_HOST: %t is dev's runtime
# directory, where its rootless engine keeps the socket. Never the system's engine.
Environment=DOCKER_HOST=unix://%t/docker.sock
# Dangling images only (no --all): untagged leftovers of a rebuilt tag, which nothing can run by name.
ExecStart=/usr/bin/docker image prune --force
# The build cache no build has used for a week, then by size (the same two runs as yggdrasil-prune-ygg.service,
# and for the same reason: BuildKit never removes a record younger than `until`): the records used least, and
# least recently, until the rest is under 20 GB.
ExecStart=/usr/bin/docker builder prune --all --force --filter until=168h
ExecStart=/usr/bin/docker builder prune --all --force --max-used-space 20GB
# A prune that hangs (an engine that never answers) must not hold the next one off for ever.
TimeoutStartSec=2h
