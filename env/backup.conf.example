# What scripts/backup.sh backs up and where it sends it (the nightly timer of ygg runs it). Copy to
# $YGG_SECRETS_DIR/backup.conf (default /etc/yggdrasil/backup.conf), chmod 600, owned by ygg, and fill in.
# Never commit the copy. Not read by Compose: NAME=value lines, then one item per line. Comments and
# empty lines are fine, but only on their own lines.

# Where the backups go, as rsync writes it: <user>@<host>:<path>. Required. The other server's
# authorized_keys line for the key restricts it to rrsync in one directory (docs/hosts.md), and the path
# is relative to that directory: <user>@<host>:. is the directory itself.
BACKUP_TARGET=

# The ssh key that logs in there. Default: ~/.ssh/yggdrasil-backup
# BACKUP_KEY=~/.ssh/yggdrasil-backup

# How many days are kept in ~/backups on this server (the other server's copy follows). Default: 7
# An item's newest good file is kept even beyond that, in its own day, so an item that fails for longer
# than BACKUP_KEEP days never loses its last good dump.
# BACKUP_KEEP=7

# The items, one per line. Each becomes one file in ~/backups/<YYYY-MM-DD>/.
#
#   forgejo                       Forgejo's own dump (repositories, database, settings), from the
#                                 `forgejo` service of the yggdrasil Compose project -> forgejo.zip
#   vars                          this machine's variables store and its key (vars.db, vars.key in
#                                 the secrets directory), a consistent copy -> vars.tar.gz
#   volume <name>                 a Docker volume, read-only, as a tar -> volume-<name>.tar.gz
#   postgres <container> <user>   pg_dumpall in that container as that database user (a stopped
#                                 container is started for it and stopped again)
#                                 -> postgres-<container>.sql.gz
#
# On the DevOps Server (Forgejo, Jenkins):
# forgejo
# vars
# volume yggdrasil_jenkins
#
# On an Application Server (its settings, an app's database):
# vars
# postgres myapp-db-1 postgres
