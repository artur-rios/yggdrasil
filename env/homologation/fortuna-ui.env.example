# fortuna-ui in homologation. Copy to /etc/yggdrasil/homologation/fortuna-ui.env on the homologation host.
# Everything but UI_HOST is compiled into the public JavaScript bundle: no secrets.

# Where Traefik serves the UI. fortuna-api is served under the same host at /api/.
UI_HOST=fortuna.hml.example.com

# Same-origin: the UI's own host. The API routes already begin with /api/.
FORTUNA_API_BASE_URL=https://fortuna.hml.example.com
FORTUNA_GOOGLE_CLIENT_ID=
