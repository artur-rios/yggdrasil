# heimdall-ui in homologation. Copy to /etc/yggdrasil/homologation/heimdall-ui.env on the homologation host.
# Everything but UI_HOST is compiled into the public JavaScript bundle: no secrets.

# Where Traefik serves the UI. heimdall-api is served under the same host at /api/.
UI_HOST=heimdall.hml.example.com

# Same-origin: the UI's own host. The API routes already begin with /api/.
HEIMDALL_API_BASE_URL=https://heimdall.hml.example.com
HEIMDALL_GOOGLE_CLIENT_ID=
HEIMDALL_SCOPE_ID=
