# Credentials of the DNS provider named by ACME_DNS_PROVIDER in platform.env. Traefik uses them to
# answer the Let's Encrypt DNS-01 challenge; no other container sees this file. Copy to
# $YGG_SECRETS_DIR/acme.env (default /etc/yggdrasil/acme.env) and chmod 600.
#
# The variable names depend on the provider: https://go-acme.github.io/lego/dns/ lists them. Some:
#
#   cloudflare     CF_DNS_API_TOKEN          (API token with Zone > DNS > Edit on the zone)
#   route53        AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION, AWS_HOSTED_ZONE_ID
#   digitalocean   DO_AUTH_TOKEN
#   ovh            OVH_ENDPOINT, OVH_APPLICATION_KEY, OVH_APPLICATION_SECRET, OVH_CONSUMER_KEY
#   gandiv5        GANDIV5_PERSONAL_ACCESS_TOKEN

CF_DNS_API_TOKEN=
