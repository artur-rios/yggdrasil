# With the variables store (docs/variables.md) these values are imported with `scripts/ygg.sh vars import --all`; this file is then only the template.
# The platform stack of one host (platform/compose.yml, run by scripts/platform.sh). Copy to
# $YGG_SECRETS_DIR/platform.env (default /etc/yggdrasil/platform.env), chmod 640, and fill in.
# Never commit the copy. Reference: docs/setup.md, steps 9.2 and 10.
#
# "required" variables must have a value, or every platform.sh command stops with "required
# variable ... is missing a value". "required with profile ..." ones are checked by platform.sh up
# when COMPOSE_PROFILES turns that profile on. Values are read by bash as well as Compose: use
# letters and digits in passwords (openssl rand -hex 16), and put comments on their own lines.

# required with profile apps. The environments this host runs, comma-separated, no spaces:
# environment ids from catalog.yaml (python3 scripts/catalog.py environments lists them), e.g. one
# VPS running three: development,homologation,production. One platform stack serves them all: the
# status API and the console show each of them, Prometheus scrapes each, and scripts/ygg.sh offers
# them.
# A platform.env from before 0.5 has ENVIRONMENT=<one id> instead: it still works, as a list of one;
# ENVIRONMENTS wins when both are set.
ENVIRONMENTS=

# Which parts this host runs:
#   apps     the status API (with its Docker socket proxy) and the console -- on every host that runs
#            applications; ENVIRONMENTS below belongs to it, and is refused without it
#   forge    Forgejo, the git forge, at git.DOMAIN -- on the development machine
#   jenkins  the Jenkins controller -- on exactly one host, reachable from GitHub for webhooks
#   agent    the Jenkins agent that deploys to this host's environments -- on every host Jenkins deploys to
# e.g. apps,jenkins,agent on the host with the controller, apps,agent on the others.
# Leave jenkins and agent out at first: an agent needs a secret that exists only once the controller
# has created it. Controller host: apps,jenkins at docs/setup.md step 9.2, then apps,jenkins,agent at
# 9.5. Other hosts: apps,agent at step 10.
# The platform runs on the rootless Docker engine of the user running scripts/platform.sh (its
# socket is found, and mounted, by the script): there is no Docker group or socket setting here.
COMPOSE_PROFILES=apps

# ---- Traefik / Let's Encrypt ------------------------------------------------------------
# The host's base domain. Every public host name is one level under it (<host><hostSuffix>.DOMAIN:
# the catalog's `host`, plus the environment's `hostSuffix`), so one wildcard certificate and one
# DNS record, *.DOMAIN, cover them all. Environments sharing this host share DOMAIN and differ by
# hostSuffix: heimdall-dev.example.com, heimdall-hml.example.com, heimdall.example.com. A host of its
# own per environment gets its own DOMAIN instead (example.com, staging.example.com, ...).
# required: replace example.com with your domain.
DOMAIN=example.com
# More domains this host serves, comma-separated, each with its own wildcard certificate (the same
# DNS provider must manage them all), e.g. artur-rios.tech. Empty: just DOMAIN.
EXTRA_DOMAINS=
# true when the domains' DNS records are proxied by Cloudflare (orange cloud): Traefik then trusts the
# forwarded client address from Cloudflare's ranges only (<secrets>/cloudflare-ips, written by
# `ygg install`), and refuses to start without them. false when clients connect directly.
CLOUDFLARE_PROXIED=false
# required. Your e-mail address, the Let's Encrypt account's contact. Not an @example.com address:
# Let's Encrypt refuses those.
ACME_EMAIL=
# The certificate is issued with the DNS-01 challenge, which works behind NAT and issues
# wildcards: the code of your DNS provider (https://doc.traefik.io/traefik/https/acme/#providers),
# e.g. cloudflare, duckdns, route53, digitalocean, ovh, gandiv5. Its credentials go in acme.env.
# Step by step for Cloudflare and DuckDNS: docs/dns.md. required.
ACME_DNS_PROVIDER=cloudflare
# Uncomment for the first run: staging certificates are untrusted but not rate limited. Comment it
# out again once they work, then delete the yggdrasil_letsencrypt volume (docs/dns.md, Bring it up).
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# Public resolvers Traefik checks the challenge's TXT record against. Default below.
# ACME_DNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53

# required. Basic auth for https://traefik.DOMAIN. Generate with: htpasswd -nB admin (it asks for the
# password twice and prints admin:<hash>). Replace the placeholder: no password matches it.
# Keep the single quotes: without them Compose tries to expand the $ in the hash.
TRAEFIK_DASHBOARD_USERS='admin:$2y$05$replace-me'

# ---- Grafana / Prometheus ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# required. e.g. openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=30d

# ---- Status API / console (https://yggdrasil.DOMAIN) --------------------------------------
# required. The bearer token the console sends. At least 32 characters: openssl rand -hex 32. One per
# host (it covers every environment of the host); keep a copy, the Windows and Android consoles ask
# for it.
YGGDRASIL_STATUS_TOKEN=
# Other origins allowed to call this host's status API from a browser -- e.g. another host's web
# console: https://yggdrasil.staging.example.com
YGGDRASIL_STATUS_CORS_ORIGINS=
# Hosts the web console offers before any is configured (compiled into its bundle; no tokens), one
# per host, not per environment:
# [{"name":"VPS","url":"https://yggdrasil.example.com"},{"name":"Staging","url":"https://yggdrasil.staging.example.com"}]
YGGDRASIL_CONSOLE_ENVIRONMENTS=

# ---- Forgejo (profile forge) -------------------------------------------------------------
# Forgejo is served at https://git.DOMAIN and needs no other setting: registration is closed, signing
# in is required to see anything, and the data is a SQLite database in the yggdrasil_forgejo-data
# volume. The first account is created once it is up, as the user that runs scripts/platform.sh
# (ygg, on the development machine), from the repository checkout:
#   docker compose -p yggdrasil exec forgejo forgejo admin user create --admin --username NAME --email EMAIL --random-password
# The host port for git over SSH (git@git.DOMAIN:owner/repository.git, with -p when it is not 22).
# The host's firewall must let it in on the development machine. Default 2222.
FORGEJO_SSH_PORT=2222

# ---- Jenkins controller (profile jenkins) -----------------------------------------------
# The GitHub owner and this repository's name come from catalog.yaml (owner, repository).
# required with profile jenkins or agent. The controller's address, on every host: jenkins. and the
# DOMAIN of the host that runs it.
JENKINS_URL=https://jenkins.example.com/
JENKINS_ADMIN_ID=admin
# required with profile jenkins. e.g. openssl rand -hex 16
JENKINS_ADMIN_PASSWORD=
# The GitHub App's ID (Settings > Developer settings > GitHub Apps) and its private key, converted
# to PKCS#8 -- see docs/setup.md steps 7 and 9.1. Both required with profile jenkins.
GITHUB_APP_ID=
GITHUB_APP_KEY_FILE=/etc/yggdrasil/github-app.pem

# ---- Jenkins agent (profile agent) ------------------------------------------------------
# This host's agent: the `agent` its environments set in catalog.yaml (environments sharing a host
# share one agent, e.g. vps; an environment without `agent` uses its id). required with profile
# agent, like the secret below.
JENKINS_AGENT_NAME=
# From the controller: Manage Jenkins > Nodes > <agent>, once the controller is up (setup.md 9.4; it goes here at 9.5).
JENKINS_AGENT_SECRET=
# How the agent reaches the controller. On the controller's own host: http://jenkins:8080/ (over
# the edge network). Elsewhere leave it empty: the agent dials JENKINS_URL out through the internet
# over a WebSocket, so the host needs no inbound port.
JENKINS_AGENT_URL=
# Where this host's env files live (this file, acme.env, and <environment>/<application>.env for
# each of its environments), mounted read-only into the agent at /etc/yggdrasil, and where Traefik's
# acme.env is read from. Must equal the YGG_SECRETS_DIR exported in your shell, if you changed it.
YGG_SECRETS_DIR=/etc/yggdrasil
