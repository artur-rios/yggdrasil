# The platform stack of one host (platform/compose.yml). Copy to $YGG_SECRETS_DIR/platform.env
# (default /etc/yggdrasil/platform.env), chmod 600, and fill in. Never commit the copy.

# homologation | production. Becomes the environment label on every log line in Loki.
ENVIRONMENT=production

# jenkins,agent on the VPS (production); agent on the WSL machine (homologation).
COMPOSE_PROFILES=jenkins,agent

# ---- Traefik / Let's Encrypt ------------------------------------------------------------
# The environment's base domain. Every host name is one level under it, so one wildcard certificate
# (*.DOMAIN) covers them all:
#   production    example.com       heimdall.example.com, heimdall-api.example.com, grafana..., jenkins...
#   homologation  hml.example.com   heimdall.hml.example.com, ...
# In Cloudflare, *.hml.example.com points at the homologation machine's LAN address and must be
# "DNS only" (grey cloud); the production records may be proxied or not.
DOMAIN=example.com
ACME_EMAIL=
# Cloudflare API token with Zone > DNS > Edit on the zone (My Profile > API Tokens > Edit zone DNS).
CF_DNS_API_TOKEN=
# Uncomment while testing: staging certificates are untrusted but not rate limited.
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Basic auth for https://traefik.DOMAIN. Generate with: htpasswd -nB admin
# Keep the single quotes: without them Compose tries to expand the $ in the hash.
TRAEFIK_DASHBOARD_USERS='admin:$2y$05$replace-me'

# ---- Grafana / Prometheus ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=30d

# ---- Jenkins controller (profile jenkins, production only) ------------------------------
JENKINS_URL=https://jenkins.example.com/
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=
GITHUB_OWNER=artur-rios
# The GitHub App's ID (Settings > Developer settings > GitHub Apps > yggdrasil) and its private key,
# converted to PKCS#8 -- see the README.
GITHUB_APP_ID=
GITHUB_APP_KEY_FILE=/etc/yggdrasil/github-app.pem

# ---- Jenkins agent (profile agent) ------------------------------------------------------
# production on the VPS, homologation on the WSL machine: the node names in casc.yaml.
JENKINS_AGENT_NAME=production
# From the controller: Manage Jenkins > Nodes > <name>, once it is running.
JENKINS_AGENT_SECRET=
# On the VPS the agent reaches the controller directly; homologation leaves this unset and connects
# to JENKINS_URL through the internet.
JENKINS_AGENT_URL=http://jenkins:8080/
# getent group docker | cut -d: -f3
DOCKER_GID=
# Where the application env files live on this host, mounted read-only into the agent.
YGG_SECRETS_DIR=/etc/yggdrasil
