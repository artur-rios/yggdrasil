# The platform stack of one host (platform/compose.yml, run by scripts/platform.sh). Copy to
# $YGG_SECRETS_DIR/platform.env (default /etc/yggdrasil/platform.env), chmod 600, and fill in.
# Never commit the copy. Reference: docs/setup.md.

# The environment this host runs: an environment id from catalog.yaml. Labels every log line in
# Loki and names the environment in the status API and the console.
ENVIRONMENT=

# Which optional parts this host runs:
#   jenkins  the Jenkins controller -- on exactly one host, reachable from GitHub for webhooks
#   agent    the Jenkins agent that deploys to this host's environment -- on every host Jenkins deploys to
# e.g. jenkins,agent on the host with the controller, agent on the others, empty for none.
COMPOSE_PROFILES=agent

# ---- Traefik / Let's Encrypt ------------------------------------------------------------
# The environment's base domain. Every public host name is one level under it (<host>.DOMAIN, the
# catalog's `host`), so one wildcard certificate, *.DOMAIN, covers them all. Each environment gets
# its own: example.com, staging.example.com, ...
DOMAIN=example.com
ACME_EMAIL=
# The certificate is issued with the DNS-01 challenge, which works behind NAT and issues
# wildcards: the code of your DNS provider (https://doc.traefik.io/traefik/https/acme/#providers),
# e.g. cloudflare, route53, digitalocean, ovh, gandiv5. Its credentials go in acme.env.
ACME_DNS_PROVIDER=cloudflare
# Uncomment while testing: staging certificates are untrusted but not rate limited.
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Basic auth for https://traefik.DOMAIN. Generate with: htpasswd -nB admin
# Keep the single quotes: without them Compose tries to expand the $ in the hash.
TRAEFIK_DASHBOARD_USERS='admin:$2y$05$replace-me'

# ---- Grafana / Prometheus ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=30d

# ---- Status API / console (https://yggdrasil.DOMAIN) --------------------------------------
# The bearer token the console sends. At least 32 characters: openssl rand -hex 32
YGGDRASIL_STATUS_TOKEN=
# Other origins allowed to call this environment's status API from a browser -- e.g. another
# environment's web console: https://yggdrasil.example.com
YGGDRASIL_STATUS_CORS_ORIGINS=
# Environments the web console offers before any is configured (compiled into its bundle; no tokens):
# [{"name":"Production","url":"https://yggdrasil.example.com"},{"name":"Staging","url":"https://yggdrasil.staging.example.com"}]
YGGDRASIL_CONSOLE_ENVIRONMENTS=

# ---- Jenkins controller (profile jenkins) -----------------------------------------------
# The GitHub owner and this repository's name come from catalog.yaml (owner, repository).
JENKINS_URL=https://jenkins.example.com/
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=
# The GitHub App's ID (Settings > Developer settings > GitHub Apps) and its private key, converted
# to PKCS#8 -- see docs/setup.md.
GITHUB_APP_ID=
GITHUB_APP_KEY_FILE=/etc/yggdrasil/github-app.pem

# ---- Jenkins agent (profile agent) ------------------------------------------------------
# The agent of this host's environment: its `agent` in catalog.yaml, which defaults to its id.
JENKINS_AGENT_NAME=
# From the controller: Manage Jenkins > Nodes > <agent>, once it is running.
JENKINS_AGENT_SECRET=
# How the agent reaches the controller. On the controller's own host: http://jenkins:8080/ (over
# the edge network). Elsewhere leave it empty: the agent dials JENKINS_URL out through the internet
# over a WebSocket, so the host needs no inbound port.
JENKINS_AGENT_URL=
# getent group docker | cut -d: -f3
DOCKER_GID=
# Where this host's env files live (this file, acme.env, <environment>/<application>.env), mounted
# read-only into the agent.
YGG_SECRETS_DIR=/etc/yggdrasil
