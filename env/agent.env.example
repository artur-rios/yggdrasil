# The Jenkins build agent of one service user (platform/build-agent.yml, run by scripts/agent.sh as
# that user: ci or release). Copy to $YGG_SECRETS_DIR/agent.env (default /etc/yggdrasil-<user>/agent.env),
# chmod 600, owned by that user, and fill in. Never commit the copy. Every variable is required.
# Values are read by bash as well as Compose: put comments on their own lines.

# The controller's address; the agent dials out to it over WebSocket: https://jenkins.<DOMAIN>/ of the
# dev machine (https://jenkins.techcraftsmen.net/, say). Left empty on purpose, like the name and the
# workdir below.
JENKINS_URL=

# The node's name in Jenkins, also the Compose project's: yggdrasil-agent-<name>. Lowercase letters,
# digits, - and _. Left empty on purpose, so a copy nobody edited fails instead of starting the wrong
# node: `ci` for the ci user, `release` for the release user.
JENKINS_AGENT_NAME=

# The node's secret, shown on its page in Jenkins once the node exists.
JENKINS_AGENT_SECRET=

# Where the agent works: an absolute path, owned by this user, mounted at the same path in the agent
# and on the host so a check's `docker run -v $WORKSPACE:...` finds the same directory in the engine.
# The user's home plus /agent: /home/ci/agent for ci, /home/release/agent for release. Left empty on
# purpose, like the name.
YGG_AGENT_WORKDIR=
