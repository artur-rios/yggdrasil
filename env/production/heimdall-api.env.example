# heimdall-api in production. Copy to $YGG_SECRETS_DIR/production/heimdall-api.env (default /etc/yggdrasil/...) on the
# production host -- never commit the copy.
#
# Start from the repository's own template, which documents every variable the API reads:
#
#     cp heimdall-api/docker/production.env.example /etc/yggdrasil/production/heimdall-api.env
#
# then set or override what follows. API_PORT and COMPOSE_PROJECT_NAME from that template are
# ignored here: stacks/heimdall-api.proxy.yml removes the host port and deploy.sh names the project.

# The host names Traefik routes to this API, both covered by the *.DOMAIN wildcard certificate:
# its own, and the web UI's, under which it serves its /api/ routes (stacks/heimdall-api.proxy.yml).
PUBLIC_HOST=heimdall-api.example.com
UI_HOST=heimdall.example.com

# Production
ASPNETCORE_ENVIRONMENT=Production

# Postgres on the host itself; host.docker.internal is mapped to the host by the API's compose file.
DB_HOST=host.docker.internal

# heimdall-ui reaches the API under its own origin (UI_HOST/api/), so it needs no CORS entry. List
# any other browser origin that calls the API directly, e.g. https://fortuna.example.com if
# fortuna-ui signs in against heimdall-api from the browser.
HEIMDALL_CORS_ALLOWED_ORIGINS=

# Public URLs of heimdall-ui, as the recipient follows them from an e-mail.
HEIMDALL_EMAIL_VERIFICATION_URL=https://heimdall.example.com/verify-email
HEIMDALL_PASSWORD_RESET_URL=https://heimdall.example.com/reset-password
