# heimdall-api in homologation. Copy to $YGG_SECRETS_DIR/homologation/heimdall-api.env (default /etc/yggdrasil/...) on the
# homologation host -- never commit the copy.
# Replace example.com with your domain everywhere below (hml.example.com -> hml.<your domain>).
#
# Start from the repository's own template, which documents every variable the API reads:
#
#     cp heimdall-api/docker/production.env.example /etc/yggdrasil/homologation/heimdall-api.env
#
# then set or override what follows. API_PORT and COMPOSE_PROJECT_NAME from that template are
# ignored here: stacks/heimdall-api.proxy.yml removes the host port and deploy.sh names the project.

# The host names Traefik routes to this API, both covered by the *.DOMAIN wildcard certificate:
# its own, and the web UI's, under which it serves its /api/ routes (stacks/heimdall-api.proxy.yml).
PUBLIC_HOST=heimdall-api.hml.example.com
UI_HOST=heimdall.hml.example.com

# Staging: not Development (no Swagger, no developer exception page), and not Production -- so
# verification and reset e-mails are logged instead of sent and no Mailgun account is needed. Use
# Production instead if homologation must send real e-mail (then set the Mailgun variables).
ASPNETCORE_ENVIRONMENT=Staging

# Postgres on the host itself; host.docker.internal is mapped to the host by the API's compose file.
DB_HOST=host.docker.internal

# heimdall-ui reaches the API under its own origin (UI_HOST/api/), so it needs no CORS entry. List
# any other browser origin that calls the API directly, e.g. https://fortuna.example.com if
# fortuna-ui signs in against heimdall-api from the browser.
HEIMDALL_CORS_ALLOWED_ORIGINS=

HEIMDALL_EMAIL_VERIFICATION_URL=https://heimdall.hml.example.com/verify-email
HEIMDALL_PASSWORD_RESET_URL=https://heimdall.hml.example.com/reset-password
