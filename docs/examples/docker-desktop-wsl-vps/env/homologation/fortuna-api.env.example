# fortuna-api in homologation. Copy to $YGG_SECRETS_DIR/homologation/fortuna-api.env (default /etc/yggdrasil/...) on the
# homologation host -- never commit the copy.
# Replace example.com with your domain everywhere below (hml.example.com -> hml.<your domain>).
#
# Start from the repository's own template, which documents every variable the API reads:
#
#     cp fortuna-api/docker/production.env.example /etc/yggdrasil/homologation/fortuna-api.env
#
# then set or override what follows. API_PORT and COMPOSE_PROJECT_NAME from that template are
# ignored here: stacks/fortuna-api.proxy.yml removes the host port and deploy.sh names the project.

# The host names Traefik routes to this API, both covered by the *.DOMAIN wildcard certificate:
# its own, and the web UI's, under which it serves its /api/ routes (stacks/fortuna-api.proxy.yml).
PUBLIC_HOST=fortuna-api.hml.example.com
UI_HOST=fortuna.hml.example.com

# Production, like production: fortuna-api treats every other environment as a debugging one
# (detailed errors, OpenAPI UI -- Program.cs checks IsProduction), which homologation must not be.
ASPNETCORE_ENVIRONMENT=Production

# Postgres on the host itself; host.docker.internal is mapped to the host by the API's compose file.
DB_HOST=host.docker.internal

# Server to server, over the edge network -- not through Traefik and the internet.
FORTUNA_HEIMDALL_BASE_URL=http://heimdall-api:8080/
