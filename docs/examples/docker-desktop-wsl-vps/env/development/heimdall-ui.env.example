# heimdall-ui on Docker Desktop, at http://127.0.0.1:8081. Calls the API published by
# heimdall-api's local.env (API_PORT); that API must list http://127.0.0.1:8081 in
# HEIMDALL_CORS_ALLOWED_ORIGINS, since here the UI and the API are on different origins.
UI_PORT=127.0.0.1:8081
HEIMDALL_API_BASE_URL=http://127.0.0.1:8080
HEIMDALL_GOOGLE_CLIENT_ID=
HEIMDALL_SCOPE_ID=
