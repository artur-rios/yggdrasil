# fortuna-api on Docker Desktop, against the PostgreSQL installed on Windows. This is the repository's
# own local template; copy it rather than this file:
#
#     cp ../fortuna-api/docker/local.env.example env/development/fortuna-api.env
#
# and run with YGG_SECRETS_DIR pointing at env/ in your yggdrasil checkout (see the README). No Traefik in
# development: the API is published on the host at API_PORT (127.0.0.1:<port>).
