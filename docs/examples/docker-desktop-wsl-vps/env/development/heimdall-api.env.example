# heimdall-api on Docker Desktop, against the PostgreSQL installed on Windows. This is the repository's
# own local template; copy it rather than this file:
#
#     cp heimdall-api/docker/local.env.example yggdrasil/env/development/heimdall-api.env
#
# and run with YGG_SECRETS_DIR pointing at yggdrasil/env (see the README). No Traefik in
# development: the API is published on the host at API_PORT (127.0.0.1:<port>).
