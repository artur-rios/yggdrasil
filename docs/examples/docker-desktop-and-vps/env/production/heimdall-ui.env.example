# heimdall-ui in `production`: the VPS. Always on: Jenkins deploys a release/x.y.z -> main pull
# request once its checks pass. The copy lives at /etc/yggdrasil/production/heimdall-ui.env on the
# VPS -- never commit it. example.com stands for your domain, the DOMAIN of the VPS's platform.env.
#
# heimdall-ui has no env template of its own: this is the whole file. Everything but UI_HOST is
# compiled into the public JavaScript bundle: no secrets.

# Where Traefik serves the UI: the catalog's host plus the environment's hostSuffix (none).
# heimdall-api is served under the same host at /api/.
UI_HOST=heimdall.example.com

# Same origin: the UI's own host. The API routes already begin with /api/, so no CORS is needed.
HEIMDALL_API_BASE_URL=https://heimdall.example.com
HEIMDALL_GOOGLE_CLIENT_ID=
HEIMDALL_SCOPE_ID=
