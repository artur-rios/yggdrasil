# heimdall-ui in `homologation`: the VPS. On demand: Jenkins deploys every push of a release/x.y.z
# branch, and the environment runs only while it is used (ygg env start homologation on
# the VPS). The copy lives at /etc/yggdrasil/homologation/heimdall-ui.env on the VPS -- never commit
# it. example.com stands for your domain, the DOMAIN of the VPS's platform.env. heimdall-ui has no
# env template of its own: this is the whole file. Everything but UI_HOST is compiled into the
# public JavaScript bundle: no secrets.

# Where Traefik serves the UI: the catalog's host plus the environment's hostSuffix (-hml).
# heimdall-api is served under the same host at /api/.
UI_HOST=heimdall-hml.example.com

# Same origin: the UI's own host. The API routes already begin with /api/, so no CORS is needed.
HEIMDALL_API_BASE_URL=https://heimdall-hml.example.com
HEIMDALL_GOOGLE_CLIENT_ID=
HEIMDALL_SCOPE_ID=
