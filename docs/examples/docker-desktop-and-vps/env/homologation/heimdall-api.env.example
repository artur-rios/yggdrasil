# heimdall-api in `homologation`: the VPS. On demand: Jenkins deploys every push of a release/x.y.z
# branch, and the environment runs only while it is used (scripts/ygg.sh env start homologation on
# the VPS). The copy lives at /etc/yggdrasil/homologation/heimdall-api.env on the VPS -- never
# commit it. example.com stands for your domain, the DOMAIN of the VPS's platform.env.
#
# Start from the repository's own template, which documents every variable the API reads and already
# sets this environment's ASPNETCORE_ENVIRONMENT (Staging) and database (heimdall_homologation):
#
#     cp heimdall-api/docker/homologation.env.example /etc/yggdrasil/homologation/heimdall-api.env
#
# then fill in its secrets: this environment's own, never another's. Below is what yggdrasil relies
# on: check the copy has these values. API_PORT and COMPOSE_PROJECT_NAME are ignored here:
# stacks/heimdall-api.proxy.yml removes the host port, and deploy.sh names the project
# heimdall-api-homologation.

# The host names Traefik routes to this API (stacks/heimdall-api.proxy.yml): its own, and the web
# UI's, under which it also serves its /api/ routes. The catalog's host plus the environment's
# hostSuffix (-hml), one label under the *.example.com wildcard.
PUBLIC_HOST=heimdall-api-hml.example.com
UI_HOST=heimdall-hml.example.com

# PostgreSQL on the VPS itself, one database and login per environment (see the README):
# host.docker.internal is mapped to the host by the API's compose file.
DB_HOST=host.docker.internal
DB_NAME=heimdall_homologation

# Traefik is a container on the shared edge network: trust the Docker networks, so the rate limiter
# and the request log see the real caller.
HEIMDALL_TRUSTED_PROXIES=172.16.0.0/12

# fortuna-api in homologation verifies heimdall's tokens with this same secret
# (FORTUNA_AUTH_TOKEN_SECRET). openssl rand -base64 48
HEIMDALL_AUTH_TOKEN_SECRET=
