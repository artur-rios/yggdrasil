# fortuna-ui in `development`: the VPS. On demand: Jenkins deploys every push to develop, and the
# environment runs only while it is used (ygg env start development on the VPS). The copy
# lives at /etc/yggdrasil/development/fortuna-ui.env on the VPS -- never commit it. example.com
# stands for your domain, the DOMAIN of the VPS's platform.env. fortuna-ui has no env template of
# its own: this is the whole file. Everything but UI_HOST is compiled into the public JavaScript
# bundle: no secrets.

# Where Traefik serves the UI: the catalog's host plus the environment's hostSuffix (-dev).
# fortuna-api is served under the same host at /api/.
UI_HOST=fortuna-dev.example.com

# Same origin: the UI's own host. The API routes already begin with /api/, so no CORS is needed.
FORTUNA_API_BASE_URL=https://fortuna-dev.example.com
FORTUNA_GOOGLE_CLIENT_ID=
