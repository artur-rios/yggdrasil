# fortuna-api in `development`: the VPS. On demand: Jenkins deploys every push to develop, and the
# environment runs only while it is used (scripts/ygg.sh env start development on the VPS). The copy
# lives at /etc/yggdrasil/development/fortuna-api.env on the VPS -- never commit it. example.com
# stands for your domain, the DOMAIN of the VPS's platform.env.
#
# Start from the repository's own template, which documents every variable the API reads and already
# sets this environment's ASPNETCORE_ENVIRONMENT (Development) and database (fortuna_development):
#
#     cp fortuna-api/docker/development.env.example /etc/yggdrasil/development/fortuna-api.env
#
# then fill in its secrets: this environment's own, never another's. Below is what yggdrasil relies
# on: check the copy has these values. API_PORT and COMPOSE_PROJECT_NAME are ignored here:
# stacks/fortuna-api.proxy.yml removes the host port, and deploy.sh names the project
# fortuna-api-development.

# The host names Traefik routes to this API (stacks/fortuna-api.proxy.yml): its own, and the web
# UI's, under which it also serves its /api/ routes. The catalog's host plus the environment's
# hostSuffix (-dev), one label under the *.example.com wildcard.
PUBLIC_HOST=fortuna-api-dev.example.com
UI_HOST=fortuna-dev.example.com

# PostgreSQL on the VPS itself, one database and login per environment (see the README):
# host.docker.internal is mapped to the host by the API's compose file.
DB_HOST=host.docker.internal
DB_NAME=fortuna_development

# Traefik is a container on the shared edge network: trust the Docker networks, so the rate limiter
# and the request log see the real caller.
FORTUNA_FORWARDED_KNOWN_NETWORKS=172.16.0.0/12

# heimdall-api of the same environment. It must be HTTPS, so it is its public host, through Traefik,
# rather than its alias on the edge network (heimdall-api.development).
FORTUNA_HEIMDALL_BASE_URL=https://heimdall-api-dev.example.com/

# The same value as HEIMDALL_AUTH_TOKEN_SECRET in /etc/yggdrasil/development/heimdall-api.env.
FORTUNA_AUTH_TOKEN_SECRET=
