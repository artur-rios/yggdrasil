# heimdall-ui in `local`, at http://localhost:8081. Copy to env/local/heimdall-ui.env in your
# yggdrasil checkout (heimdall-ui has no env template of its own: this is the whole file).
# Everything but UI_PORT is compiled into the public JavaScript bundle: no secrets.

# Published on the loopback interface only (stacks/heimdall-ui.ports.yml).
UI_PORT=127.0.0.1:8081

# The local heimdall-api. It is on another origin here, so its docker/local.env lists
# http://localhost:8081 in HEIMDALL_CORS_ALLOWED_ORIGINS: open the UI at localhost, not 127.0.0.1.
HEIMDALL_API_BASE_URL=http://localhost:8080
HEIMDALL_GOOGLE_CLIENT_ID=
HEIMDALL_SCOPE_ID=
