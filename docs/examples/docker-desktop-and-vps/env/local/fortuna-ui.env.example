# fortuna-ui in `local`, at http://localhost:8082. Copy to env/local/fortuna-ui.env in your
# yggdrasil checkout (fortuna-ui has no env template of its own: this is the whole file). Everything
# but UI_PORT is compiled into the public JavaScript bundle: no secrets.

# Published on the loopback interface only (stacks/fortuna-ui.ports.yml).
UI_PORT=127.0.0.1:8082

# The local fortuna-api. It has no CORS support, so a browser refuses its answers to a page on
# another origin: this container checks the build itself. For browser work against the local API,
# use `flutter run -d chrome --web-browser-flag=--disable-web-security` (fortuna-ui's README).
FORTUNA_API_BASE_URL=http://localhost:8083
FORTUNA_GOOGLE_CLIENT_ID=
